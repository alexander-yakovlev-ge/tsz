# Локальное окружение. Скопируйте в .env (make up делает это автоматически) и смените пароли.

# Адреса, на которые отвечает Caddy. «proxy» нужен для e2e-тестов внутри docker-сети.
SITE_ADDRESS=localhost, proxy
# internal — локальный сертификат Caddy; на сервере — e-mail для Let's Encrypt.
TLS_MODE=internal
# Публичный адрес сайта: canonical, hreflang, sitemap.xml, robots.txt.
SITE_URL=https://localhost
HTTP_PORT=80
HTTPS_PORT=443

POSTGRES_PASSWORD=change-me-postgres

# Учётные данные S3-хранилища (SeaweedFS).
S3_ACCESS_KEY=tsz-app
S3_SECRET_KEY=change-me-s3-secret

# Секрет подписи сессии (JWT), общий для api и web. Не короче 32 символов.
# Сгенерировать: openssl rand -base64 48
JWT_SECRET=change-me-jwt-secret-at-least-32-characters-long

# Ключ шифрования номеров документов собственников. Не короче 32 символов.
# Сменить после загрузки данных нельзя: номера станут нечитаемыми. Хранить в резервной копии.
# Сгенерировать: openssl rand -base64 48
ID_NUMBERS_KEY=change-me-id-numbers-key-at-least-32-characters

# Тестовый API для e2e (/api/test/*). В продакшене — false.
ENABLE_TEST_API=true

# Первый администратор (создаётся seed'ом, если его нет). Телефон — в формате E.164.
ADMIN_PHONE=+995555000000
ADMIN_PASSWORD=change-me-admin
ADMIN_NAME=Administrator
