// Схема БД сайта ТСЖ. Модели добавляются по этапам плана (docs/plan.md).
// Частичные уникальные индексы создаются вручную в SQL-миграциях (Prisma их не поддерживает).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  RESIDENT
}

enum Locale {
  ka
  ru
  en
}

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  // Уникальность среди неудалённых: частичный индекс users_phone_active_key в миграции.
  phone               String
  passwordHash        String    @map("password_hash")
  role                Role
  name                String?
  language            Locale    @default(ka)
  notifyAnnouncements Boolean   @default(true) @map("notify_announcements")
  notifyBalance       Boolean   @default(true) @map("notify_balance")
  tokenVersion        Int       @default(0) @map("token_version")
  announcementsSeenAt DateTime? @map("announcements_seen_at")
  deletedAt           DateTime? @map("deleted_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  auditLogs     AuditLog[]
  announcements Announcement[]
  documents     Document[]
  owners        Owner[]
  unitDocuments UnitDocument[]

  @@index([phone])
  @@map("users")
}

model Contact {
  id                  String   @id @default(uuid()) @db.Uuid
  chairmanNameKa      String   @map("chairman_name_ka")
  chairmanNameRu      String   @map("chairman_name_ru")
  chairmanNameEn      String   @map("chairman_name_en")
  chairmanPhone       String   @map("chairman_phone")
  contactPersonNameKa String   @map("contact_person_name_ka")
  contactPersonNameRu String   @map("contact_person_name_ru")
  contactPersonNameEn String   @map("contact_person_name_en")
  contactPersonPhone  String   @map("contact_person_phone")
  /// Публичный канал ТСЖ в Telegram: только https://t.me/…
  telegramUrl         String?  @map("telegram_url")
  /// Публичный канал ТСЖ в WhatsApp: https://whatsapp.com/channel/… или https://chat.whatsapp.com/…
  whatsappUrl         String?  @map("whatsapp_url")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("contacts")
}

model HomePage {
  id        String   @id @default(uuid()) @db.Uuid
  nameKa    String   @map("name_ka")
  nameRu    String   @map("name_ru")
  nameEn    String   @map("name_en")
  addressKa String   @map("address_ka")
  addressRu String   @map("address_ru")
  addressEn String   @map("address_en")
  introKa   String   @map("intro_ka")
  introRu   String   @map("intro_ru")
  introEn   String   @map("intro_en")
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("home_page")
}

model DocumentCategory {
  id        String   @id @default(uuid()) @db.Uuid
  nameKa    String   @map("name_ka")
  nameRu    String   @map("name_ru")
  nameEn    String   @map("name_en")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  documents Document[]

  @@map("document_categories")
}

enum DocumentVisibility {
  PUBLIC
  OWNERS
  PRIVATE
}

/// Документ (ТЗ п. 4.9). Файл — в приватном бакете, скачивание через presigned URL.
model Document {
  id               String             @id @default(uuid()) @db.Uuid
  titleKa          String             @map("title_ka")
  titleRu          String             @map("title_ru")
  titleEn          String             @map("title_en")
  categoryId       String             @map("category_id") @db.Uuid
  category         DocumentCategory   @relation(fields: [categoryId], references: [id])
  visibility       DocumentVisibility
  storageKey       String             @unique @map("storage_key")
  originalFilename String             @map("original_filename")
  fileSize         Int                @map("file_size")
  mimeType         String             @map("mime_type")
  uploadedBy       String             @map("uploaded_by") @db.Uuid
  uploader         User               @relation(fields: [uploadedBy], references: [id])
  createdAt        DateTime           @default(now()) @map("created_at")

  @@index([categoryId, createdAt])
  @@map("documents")
}

/// Объявление (ТЗ п. 4.10). Опубликовано, если published_at ≤ now и archived_at IS NULL.
model Announcement {
  id          String    @id @default(uuid()) @db.Uuid
  titleKa     String    @map("title_ka")
  titleRu     String    @map("title_ru")
  titleEn     String    @map("title_en")
  /// Markdown без HTML, как приветствие на главной (ТЗ v1.9)
  bodyKa      String    @map("body_ka")
  bodyRu      String    @map("body_ru")
  bodyEn      String    @map("body_en")
  isPinned    Boolean   @default(false) @map("is_pinned")
  publishedAt DateTime  @map("published_at")
  archivedAt  DateTime? @map("archived_at")
  /// Флажок в интерфейсе появится вместе с push на этапе 6
  sendPush    Boolean   @default(false) @map("send_push")
  createdBy   String    @map("created_by") @db.Uuid
  author      User      @relation(fields: [createdBy], references: [id])
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([isPinned, publishedAt])
  @@map("announcements")
}

enum UnitKind {
  APARTMENT
  PARKING
  COMMERCIAL
  TECHNICAL
}

enum TariffCategory {
  FULL
  BLACK_FRAME
  PENSIONER
}

enum UnitStatus {
  ACTIVE
  /// Нет в свежей выписке: не участвует в начислениях и голосовании, история сохраняется
  ARCHIVED
}

/// Помещение — юридическая единица по выписке из реестра (ТЗ п. 4.2).
model Unit {
  id             String          @id @default(uuid()) @db.Uuid
  kind           UnitKind
  /// Ключ импорта и синхронизации с выпиской
  cadastralCode  String          @unique @map("cadastral_code")
  /// Как в реестре: «45», «5ა»
  number         String
  /// Натуральная сортировка: вид, число, суффикс (unitSortKey в @tsz/shared)
  sortKey        String          @map("sort_key")
  floor          Int?
  floorLabel     String?         @map("floor_label")
  areaM2         Decimal         @map("area_m2") @db.Decimal(8, 2)
  /// Обязательна для квартир, NULL для остальных видов
  tariffCategory TariffCategory? @map("tariff_category")
  /// Операции по балансу — этап 5
  balance        Decimal         @default(0) @db.Decimal(10, 2)
  status         UnitStatus      @default(ACTIVE)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  ownerships UnitOwnership[]
  documents  UnitDocument[]

  @@index([sortKey])
  @@map("units")
}

enum OwnerKind {
  PERSON
  COMPANY
}

/// Собственник по реестру; существует независимо от учётной записи (ТЗ п. 4.3).
model Owner {
  id           String    @id @default(uuid()) @db.Uuid
  kind         OwnerKind
  registryName String    @map("registry_name")
  displayName  String?   @map("display_name")
  /// Нормализованные номера документов, каждый зашифрован (OwnerIdsService). Только для ADMIN
  idNumbers    String[]  @map("id_numbers")
  /// HMAC нормализованных номеров — поиск совпадений без расшифровки
  idHashes     String[]  @map("id_hashes")
  userId       String?   @map("user_id") @db.Uuid
  user         User?     @relation(fields: [userId], references: [id])
  note         String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  ownerships UnitOwnership[]

  @@index([idHashes], type: Gin)
  @@index([userId])
  @@map("owners")
}

/// Право собственности (ТЗ п. 4.3.1). Одно контактное лицо на помещение — частичный индекс в миграции.
model UnitOwnership {
  id        String  @id @default(uuid()) @db.Uuid
  unitId    String  @map("unit_id") @db.Uuid
  unit      Unit    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  ownerId   String  @map("owner_id") @db.Uuid
  owner     Owner   @relation(fields: [ownerId], references: [id])
  shareNum  Int?    @map("share_num")
  shareDen  Int?    @map("share_den")
  shareNote String? @map("share_note")
  isContact Boolean @default(false) @map("is_contact")

  @@unique([unitId, ownerId])
  @@index([ownerId])
  @@map("unit_ownerships")
}

enum UnitDocumentKind {
  REGISTRY_EXTRACT
  OTHER
}

/// Документ помещения: видят администраторы и пользователи помещения (ТЗ п. 4.19).
model UnitDocument {
  id               String           @id @default(uuid()) @db.Uuid
  unitId           String           @map("unit_id") @db.Uuid
  unit             Unit             @relation(fields: [unitId], references: [id])
  kind             UnitDocumentKind
  title            String?
  storageKey       String           @unique @map("storage_key")
  originalFilename String           @map("original_filename")
  fileSize         Int              @map("file_size")
  mimeType         String           @map("mime_type")
  uploadedBy       String           @map("uploaded_by") @db.Uuid
  uploader         User             @relation(fields: [uploadedBy], references: [id])
  createdAt        DateTime         @default(now()) @map("created_at")

  @@index([unitId, createdAt])
  @@map("unit_documents")
}

/// Журнал административных и системных операций (ТЗ п. 4.17).
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  /// NULL — системная операция или неуспешный вход
  userId    String?  @map("user_id") @db.Uuid
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String?
  entityId  String?  @map("entity_id") @db.Uuid
  payload   Json?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}
