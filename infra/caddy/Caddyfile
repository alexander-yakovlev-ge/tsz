# Reverse-proxy: один домен для сайта и API (ТЗ п. 2.2).
# Локально сертификат выпускает внутренний CA Caddy (tls internal);
# корневой сертификат экспортируется командой `make cert`.
{
	admin 127.0.0.1:2019
}

{$SITE_ADDRESS} {
	tls {$TLS_MODE}

	encode zstd gzip

	request_body {
		max_size 25MB
	}

	# Загрузка документов: файл до 20 МиБ (ТЗ п. 8.6) плюс поля формы multipart.
	@document_upload path /api/documents /api/documents/*
	request_body @document_upload {
		max_size 21MiB
	}

	# Скачивание по presigned URL (ТЗ п. 6.3): путь начинается с имени бакета (S3_BUCKET).
	# Host не меняется — по нему хранилище проверяет подпись. Только чтение; cookie сайта хранилищу не нужна.
	@files {
		path /files/*
		method GET HEAD
	}
	handle @files {
		reverse_proxy storage:8333 {
			header_up -Cookie
		}
	}

	handle /api/* {
		reverse_proxy api:3001
	}

	handle {
		reverse_proxy web:3000
	}
}
